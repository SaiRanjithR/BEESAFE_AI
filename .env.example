# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/trapline

# LLM provider (Google Gemini)
# Get your free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini

# Fallback Anthropic
ANTHROPIC_API_KEY=sk-ant-placeholder
LLM_MODEL=claude-3-5-sonnet-20241022

# Twilio
TWILIO_ACCOUNT_SID=ACplaceholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_PHONE_NUMBER=+15555555555
TWILIO_WEBHOOK_URL=https://your-backend.com/webhook/sms

# Internal API auth & Multi-Role Keys (TICKET-014)
# IMPORTANT: Generate unique random keys for production!
INTERNAL_API_KEY=changeme_generate_a_random_64_char_hex_string
ADMIN_API_KEY=changeme_admin_key
ANALYST_API_KEY=changeme_analyst_key
INSTITUTION_API_KEY=changeme_institution_key

# n8n (should-have)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/enrich
N8N_ENRICHMENT_ENABLED=false

# CORS (comma-separated for multiple origins, e.g., "http://localhost:5173,https://trapline.vercel.app")
FRONTEND_ORIGIN=http://localhost:5173

# Misc
ENVIRONMENT=development
LOG_LEVEL=info
